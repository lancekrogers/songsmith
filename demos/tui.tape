# Record with: just demo  (needs Ollama for the draft step)
Output demos/tui.gif
Set Shell zsh
Set FontSize 14
Set Width 1300
Set Height 720
Set TypingSpeed 40ms

Hide
Type "rm -rf /tmp/songsmith-demo && cp -R demos/fixture /tmp/songsmith-demo && export SONGSMITH_CONFIG=demos/demo.yaml && clear" Enter
Show

Type "songsmith" Enter
Sleep 2s
Type "n"
Sleep 500ms
Type "a mellow bossa nova about a rainy Sunday in Lisbon"
Sleep 500ms
Enter
Sleep 40s
Sleep 3s
Down@400ms 6
Sleep 2s
Ctrl+D
Sleep 3s
Down
Sleep 2s
Up
Sleep 2s
Type "q"
Sleep 500ms
